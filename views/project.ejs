<%- include("partials/header", { title: "Projects" }) %>

<%- include("partials/navbar") %>


<!-- SECTION 1 -->

<section class="projects-hero">

    <span>SELECTED WORK</span>

    <h1>
        Work that
        <strong>speaks.</strong>
    </h1>

    <p>
        A collection of digital experiences
        we've created for ambitious brands.
    </p>

</section>


<!-- SECTION 2 -->

<section class="featured-project">

    <div class="project-image">
        V
    </div>

    <div class="project-info">

        <span>01 / E-COMMERCE</span>

        <h2>Vaarahi</h2>

        <p>
            A premium digital experience designed
            for a modern real estate brand.
        </p>

        <a href="#">
            View Case Study →
        </a>

    </div>

</section>


<!-- SECTION 3 -->

<section class="project-grid-section">

    <div class="project-card">
        <small>FINTECH</small>
        <h2>Finora</h2>
    </div>

    <div class="project-card">
        <small>TECHNOLOGY</small>
        <h2>TechFlow</h2>
    </div>

    <div class="project-card">
        <small>REAL ESTATE</small>
        <h2>UrbanNest</h2>
    </div>

    <div class="project-card">
        <small>BRANDING</small>
        <h2>Mono</h2>
    </div>

</section>


<!-- SECTION 4 -->

<section class="projects-cta">

    <h2>
        Your project
        could be next.
    </h2>

    <a href="/contact">
        Start a Project →
    </a>

</section>


<style>

    section {
        padding: 100px 8%;
    }

    .projects-hero {
        min-height: 65vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .projects-hero span {
        color: #8b5cf6;
        letter-spacing: 2px;
    }

    .projects-hero h1 {
        font-size: clamp(60px, 9vw, 110px);
        line-height: .9;
        margin: 25px 0;
    }

    .projects-hero strong {
        color: #8b5cf6;
    }

    .projects-hero p {
        color: #999;
        font-size: 19px;
    }

    .featured-project {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 70px;
        align-items: center;
        background: #111;
    }

    .project-image {
        height: 500px;
        background: linear-gradient(
            135deg,
            #29174d,
            #101010
        );

        border-radius: 25px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 180px;
        font-weight: bold;
        color: #8b5cf6;
    }

    .project-info span {
        color: #8b5cf6;
        font-size: 13px;
    }

    .project-info h2 {
        font-size: 70px;
        margin: 20px 0;
    }

    .project-info p {
        color: #888;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .project-info a {
        color: #8b5cf6;
    }

    .project-grid-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .project-card {
        height: 320px;
        padding: 30px;
        border: 1px solid #292929;
        border-radius: 20px;

        display: flex;
        flex-direction: column;
        justify-content: end;
    }

    .project-card:nth-child(1) {
        background: #171022;
    }

    .project-card:nth-child(2) {
        background: #102222;
    }

    .project-card:nth-child(3) {
        background: #241814;
    }

    .project-card:nth-child(4) {
        background: #171b2c;
    }

    .project-card small {
        color: #888;
    }

    .project-card h2 {
        font-size: 40px;
        margin-top: 10px;
    }

    .projects-cta {
        text-align: center;
        background: #171022;
    }

    .projects-cta h2 {
        font-size: clamp(50px, 7vw, 90px);
        margin-bottom: 30px;
    }

    .projects-cta a {
        display: inline-block;
        padding: 15px 25px;
        background: #8b5cf6;
        border-radius: 30px;
    }

    @media(max-width: 700px) {

        .featured-project {
            grid-template-columns: 1fr;
        }

        .project-grid-section {
            grid-template-columns: 1fr;
        }

        .project-image {
            height: 350px;
        }

    }

</style>

<%- include("partials/footer") %>