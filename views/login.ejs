<%- include("partials/header", { title: typeof title !== 'undefined' ? title : "Login" }) %>

<div class="auth-page">

    <div class="auth-container">

        <!-- LEFT SIDE: LOGIN FORM -->
        <div class="auth-content">

            <a href="/" class="auth-logo">
                NOVA<span>.</span>
            </a>

            <div class="auth-heading">
                <span class="tag">WELCOME BACK</span>
                <h1>
                    Welcome
                    <strong>back.</strong>
                </h1>
                <p>
                    Log in to your NOVA account and continue where you left off.
                </p>
            </div>

            <form
                action="/login"
                method="POST"
                class="auth-form"
                id="loginForm"
            >

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="you@example.com"
                        required
                        autocomplete="email"
                    >
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label for="password">Password</label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>
                    <div class="password-wrapper">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            required
                            autocomplete="current-password"
                        >
                        <button type="button" class="toggle-password" id="togglePassword" aria-label="Toggle password visibility">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="remember">
                    <label>
                        <input
                            type="checkbox"
                            name="remember"
                        >
                        <span>Remember me for 30 days</span>
                    </label>
                </div>

                <button type="submit" id="submitBtn">
                    Log In →
                </button>

            </form>

            <p class="auth-switch">
                Don't have an account?
                <a href="/signup">Create account</a>
            </p>

            <a href="/" class="back-home">
                ← Back to website
            </a>

        </div>

        <!-- RIGHT SIDE: BRAND VISUAL -->
        <div class="auth-visual">

            <div class="visual-content">
                <span>NOVA AGENCY</span>
                <h2>
                    Ideas become
                    <strong>experiences.</strong>
                </h2>
                <p>
                    Design. Technology. Strategy. Everything you need to build something remarkable.
                </p>

                <div class="visual-perks">
                    <div class="perk-card">
                        <div class="perk-icon">✦</div>
                        <div class="perk-info">
                            <h4>Unified Workspace</h4>
                            <p>Manage your brand campaigns & creative assets</p>
                        </div>
                    </div>

                    <div class="perk-card">
                        <div class="perk-icon">🔒</div>
                        <div class="perk-info">
                            <h4>Enterprise Security</h4>
                            <p>End-to-end encryption & secure cloud sessions</p>
                        </div>
                    </div>

                    <div class="perk-card">
                        <div class="perk-icon">⚡</div>
                        <div class="perk-info">
                            <h4>Real-Time Analytics</h4>
                            <p>Track project velocity and delivery milestones</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #090909;
        color: #fff;
        font-family: Arial, Helvetica, sans-serif;
    }

    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .auth-container {
        width: 100%;
        max-width: 1100px;
        min-height: 680px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #101010;
        border: 1px solid #252525;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    }

    /* LEFT SIDE */
    .auth-content {
        padding: 50px 55px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
    }

    .auth-logo {
        display: inline-block;
        font-size: 27px;
        font-weight: 800;
        margin-bottom: 30px;
        letter-spacing: -0.5px;
    }

    .auth-logo span {
        color: #8b5cf6;
    }

    .auth-heading {
        margin-bottom: 28px;
    }

    .tag {
        color: #8b5cf6;
        font-size: 12px;
        letter-spacing: 2px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .auth-heading h1 {
        font-size: 55px;
        line-height: 1;
        margin: 14px 0 12px;
    }

    .auth-heading h1 strong {
        color: #8b5cf6;
    }

    .auth-heading p {
        max-width: 440px;
        color: #888;
        font-size: 15px;
        line-height: 1.6;
        margin: 0;
    }

    /* FORM STYLES */
    .auth-form {
        max-width: 450px;
        width: 100%;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .form-group label {
        display: block;
        color: #ddd;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .label-row label {
        margin-bottom: 0;
    }

    .forgot-link {
        color: #8b5cf6;
        font-size: 13px;
        transition: color 0.2s;
    }

    .forgot-link:hover {
        color: #a78bfa;
        text-decoration: underline;
    }

    .password-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    input[type="email"],
    input[type="password"],
    input[type="text"] {
        width: 100%;
        padding: 15px 16px;
        background: #080808;
        border: 1px solid #292929;
        border-radius: 10px;
        color: #fff;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .password-wrapper input {
        padding-right: 46px;
    }

    input:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
        background: #0d0d0d;
    }

    input::placeholder {
        color: #555;
    }

    .toggle-password {
        position: absolute;
        right: 12px;
        background: none;
        border: none;
        color: #666;
        cursor: pointer;
        padding: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: color 0.2s;
    }

    .toggle-password:hover {
        color: #aaa;
    }

    .remember {
        margin: 8px 0 24px;
    }

    .remember label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #888;
        font-size: 13px;
        cursor: pointer;
    }

    .remember input {
        accent-color: #8b5cf6;
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .auth-form button[type="submit"] {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 30px;
        background: #8b5cf6;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .auth-form button[type="submit"]:hover {
        background: #7c3aed;
        transform: translateY(-1px);
        box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
    }

    .auth-form button[type="submit"]:active {
        transform: translateY(0);
    }

    .auth-switch {
        color: #777;
        font-size: 14px;
        margin-top: 24px;
    }

    .auth-switch a {
        color: #fff;
        font-weight: 600;
        margin-left: 4px;
        transition: color 0.2s;
    }

    .auth-switch a:hover {
        color: #8b5cf6;
    }

    .back-home {
        display: inline-block;
        color: #666;
        font-size: 13px;
        margin-top: 24px;
        transition: color 0.2s;
    }

    .back-home:hover {
        color: #aaa;
    }

    /* RIGHT SIDE VISUAL */
    .auth-visual {
        position: relative;
        display: flex;
        align-items: flex-end;
        padding: 55px;
        background:
            radial-gradient(
                circle at 70% 30%,
                #43217a,
                transparent 45%
            ),
            linear-gradient(
                135deg,
                #161616,
                #0c0c0c
            );
        overflow: hidden;
    }

    .auth-visual::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border: 1px solid rgba(139, 92, 246, 0.35);
        border-radius: 50%;
        top: 80px;
        right: 60px;
        opacity: 0.6;
        animation: pulseRing 8s ease-in-out infinite alternate;
    }

    .auth-visual::after {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        background: #8b5cf6;
        filter: blur(110px);
        top: 150px;
        right: 120px;
        opacity: 0.55;
    }

    @keyframes pulseRing {
        0% {
            transform: scale(0.95);
        }
        100% {
            transform: scale(1.05);
        }
    }

    .visual-content {
        position: relative;
        z-index: 2;
        width: 100%;
    }

    .visual-content > span {
        color: #8b5cf6;
        letter-spacing: 2px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .visual-content h2 {
        font-size: 52px;
        line-height: 1.05;
        margin: 18px 0 16px;
    }

    .visual-content h2 strong {
        color: #8b5cf6;
    }

    .visual-content > p {
        max-width: 420px;
        color: #999;
        line-height: 1.6;
        font-size: 15px;
        margin-bottom: 35px;
    }

    .visual-perks {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-width: 420px;
    }

    .perk-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(10px);
        border-radius: 14px;
        transition: transform 0.2s, background 0.2s;
    }

    .perk-card:hover {
        background: rgba(255, 255, 255, 0.06);
        transform: translateX(4px);
    }

    .perk-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(139, 92, 246, 0.15);
        color: #8b5cf6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .perk-info h4 {
        margin: 0 0 3px 0;
        font-size: 14px;
        color: #eee;
    }

    .perk-info p {
        margin: 0;
        font-size: 12px;
        color: #777;
    }

    /* RESPONSIVE */
    @media(max-width: 860px) {
        .auth-container {
            grid-template-columns: 1fr;
        }

        .auth-visual {
            display: none;
        }

        .auth-content {
            padding: 40px 25px;
        }

        .auth-heading h1 {
            font-size: 44px;
        }
    }

</style>

<script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    if (togglePassword && passwordInput) {
        togglePassword.addEventListener('click', function () {
            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
            togglePassword.style.color = isPassword ? '#8b5cf6' : '#666';
        });
    }
</script>

</body>
</html>