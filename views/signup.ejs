<%- include("partials/header", { title: typeof title !=='undefined' ? title : "Create Account" }) %>

    <div class="auth-page">

        <div class="auth-container">

            <!-- LEFT SIDE: SIGNUP FORM -->
            <div class="auth-content">

                <a href="/" class="auth-logo">
                    NOVA<span>.</span>
                </a>

                <div class="auth-heading">
                    <span class="tag">GET STARTED</span>
                    <h1>
                        Create
                        <strong>account.</strong>
                    </h1>
                    <p>
                        Join NOVA and start building high-impact digital experiences today.
                    </p>
                </div>

                <form action="/signup" method="POST" class="auth-form" id="signupForm">

                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" id="name" name="name" placeholder="John Doe" required autocomplete="name">
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required
                            autocomplete="email">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="Min. 6 characters"
                                required minlength="6" autocomplete="new-password">
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword">Confirm</label>
                            <input type="password" id="confirmPassword" name="confirmPassword"
                                placeholder="Repeat password" required minlength="6" autocomplete="new-password">
                        </div>
                    </div>

                    <div id="passwordError" class="form-error" style="display: none;">
                        Passwords do not match.
                    </div>

                    <div class="terms">
                        <label>
                            <input type="checkbox" name="terms" required>
                            <span>I agree to the <a href="#">Terms</a> & <a href="#">Privacy Policy</a></span>
                        </label>
                    </div>

                    <button type="submit" id="submitBtn">
                        Create Account →
                    </button>

                </form>

                <p class="auth-switch">
                    Already have an account?
                    <a href="/login">Log in</a>
                </p>

                <a href="/" class="back-home">
                    ← Back to website
                </a>

            </div>

            <!-- RIGHT SIDE: BRAND VISUAL -->
            <div class="auth-visual">

                <div class="visual-content">
                    <span>NOVA AGENCY</span>
                    <h2>
                        Turn vision into
                        <strong>reality.</strong>
                    </h2>
                    <p>
                        Join hundreds of forward-thinking brands that build cutting-edge digital experiences with us.
                    </p>

                    <div class="visual-perks">
                        <div class="perk-card">
                            <div class="perk-icon">✦</div>
                            <div class="perk-info">
                                <h4>Design & Strategy</h4>
                                <p>Crafted for modern ambitious teams</p>
                            </div>
                        </div>

                        <div class="perk-card">
                            <div class="perk-icon">⚡</div>
                            <div class="perk-info">
                                <h4>Rapid Execution</h4>
                                <p>From concept to launch at high speed</p>
                            </div>
                        </div>

                        <div class="perk-card">
                            <div class="perk-icon">★</div>
                            <div class="perk-info">
                                <h4>99% Satisfaction</h4>
                                <p>Trusted by world-class leaders</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #090909;
            color: #fff;
            font-family: Arial, Helvetica, sans-serif;
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .auth-container {
            width: 100%;
            max-width: 1100px;
            min-height: 720px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #101010;
            border: 1px solid #252525;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        }

        /* LEFT SIDE */
        .auth-content {
            padding: 50px 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        .auth-logo {
            display: inline-block;
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 25px;
            letter-spacing: -0.5px;
        }

        .auth-logo span {
            color: #8b5cf6;
        }

        .auth-heading {
            margin-bottom: 25px;
        }

        .tag {
            color: #8b5cf6;
            font-size: 12px;
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .auth-heading h1 {
            font-size: 52px;
            line-height: 1.05;
            margin: 12px 0 10px;
        }

        .auth-heading h1 strong {
            color: #8b5cf6;
        }

        .auth-heading p {
            max-width: 440px;
            color: #888;
            font-size: 15px;
            line-height: 1.6;
            margin: 0;
        }

        /* FORM STYLES */
        .auth-form {
            max-width: 450px;
            width: 100%;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            color: #ddd;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 14px 16px;
            background: #080808;
            border: 1px solid #292929;
            border-radius: 10px;
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
            background: #0d0d0d;
        }

        input::placeholder {
            color: #555;
        }

        .form-error {
            color: #ef4444;
            font-size: 13px;
            margin-bottom: 12px;
            background: rgba(239, 68, 68, 0.1);
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .terms {
            margin: 6px 0 22px;
        }

        .terms label {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #888;
            font-size: 13px;
            cursor: pointer;
        }

        .terms input {
            accent-color: #8b5cf6;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .terms a {
            color: #8b5cf6;
            text-decoration: underline;
        }

        .auth-form button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 30px;
            background: #8b5cf6;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        }

        .auth-form button:hover {
            background: #7c3aed;
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
        }

        .auth-form button:active {
            transform: translateY(0);
        }

        .auth-switch {
            color: #777;
            font-size: 14px;
            margin-top: 22px;
        }

        .auth-switch a {
            color: #fff;
            font-weight: 600;
            margin-left: 4px;
            transition: color 0.2s;
        }

        .auth-switch a:hover {
            color: #8b5cf6;
        }

        .back-home {
            display: inline-block;
            color: #666;
            font-size: 13px;
            margin-top: 22px;
            transition: color 0.2s;
        }

        .back-home:hover {
            color: #aaa;
        }

        /* RIGHT SIDE VISUAL */
        .auth-visual {
            position: relative;
            display: flex;
            align-items: flex-end;
            padding: 55px;
            background:
                radial-gradient(circle at 75% 25%,
                    #50229c,
                    transparent 45%),
                linear-gradient(135deg,
                    #161616,
                    #0c0c0c);
            overflow: hidden;
        }

        .auth-visual::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border: 1px solid rgba(139, 92, 246, 0.35);
            border-radius: 50%;
            top: 80px;
            right: 60px;
            opacity: 0.6;
            animation: pulseRing 8s ease-in-out infinite alternate;
        }

        .auth-visual::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            background: #8b5cf6;
            filter: blur(110px);
            top: 150px;
            right: 120px;
            opacity: 0.55;
        }

        @keyframes pulseRing {
            0% {
                transform: scale(0.95);
            }

            100% {
                transform: scale(1.05);
            }
        }

        .visual-content {
            position: relative;
            z-index: 2;
            width: 100%;
        }

        .visual-content>span {
            color: #8b5cf6;
            letter-spacing: 2px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .visual-content h2 {
            font-size: 48px;
            line-height: 1.05;
            margin: 18px 0 16px;
        }

        .visual-content h2 strong {
            color: #8b5cf6;
        }

        .visual-content>p {
            max-width: 420px;
            color: #999;
            line-height: 1.6;
            font-size: 15px;
            margin-bottom: 35px;
        }

        .visual-perks {
            display: flex;
            flex-direction: column;
            gap: 14px;
            max-width: 420px;
        }

        .perk-card {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(10px);
            border-radius: 14px;
            transition: transform 0.2s, background 0.2s;
        }

        .perk-card:hover {
            background: rgba(255, 255, 255, 0.06);
            transform: translateX(4px);
        }

        .perk-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(139, 92, 246, 0.15);
            color: #8b5cf6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            flex-shrink: 0;
        }

        .perk-info h4 {
            margin: 0 0 3px 0;
            font-size: 14px;
            color: #eee;
        }

        .perk-info p {
            margin: 0;
            font-size: 12px;
            color: #777;
        }

        /* RESPONSIVE */
        @media(max-width: 860px) {
            .auth-container {
                grid-template-columns: 1fr;
            }

            .auth-visual {
                display: none;
            }

            .auth-content {
                padding: 40px 25px;
            }

            .auth-heading h1 {
                font-size: 42px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
    </style>

    <script>
        const signupForm = document.getElementById('signupForm');
        const password = document.getElementById('password');
        const confirmPassword = document.getElementById('confirmPassword');
        const passwordError = document.getElementById('passwordError');

        signupForm.addEventListener('submit', function (e) {
            if (password.value !== confirmPassword.value) {
                e.preventDefault();
                passwordError.style.display = 'block';
                confirmPassword.focus();
            } else {
                passwordError.style.display = 'none';
            }
        });

        confirmPassword.addEventListener('input', function () {
            if (password.value === confirmPassword.value) {
                passwordError.style.display = 'none';
            }
        });
    </script>

    </body>

    </html>