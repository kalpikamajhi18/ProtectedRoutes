<%- include("partials/header", { title: "Contact" }) %>

<%- include("partials/navbar") %>


<!-- SECTION 1 -->

<section class="contact-hero">

    <span>GET IN TOUCH</span>

    <h1>
        Let's create
        <strong>something great.</strong>
    </h1>

    <p>
        Have an idea, project or business challenge?
        Tell us about it.
    </p>

</section>


<!-- SECTION 2 -->

<section class="contact-form-section">

    <div>

        <span>START A PROJECT</span>

        <h2>
            Tell us about
            your project.
        </h2>

    </div>


    <form>

        <input
            type="text"
            placeholder="Your Name"
        >

        <input
            type="email"
            placeholder="Email Address"
        >

        <input
            type="text"
            placeholder="Company"
        >

        <textarea
            placeholder="Tell us about your project..."
        ></textarea>

        <button type="submit">
            Send Message →
        </button>

    </form>

</section>


<!-- SECTION 3 -->

<section class="contact-info">

    <div>

        <span>EMAIL</span>

        <h3>
            hello@novaagency.com
        </h3>

    </div>

    <div>

        <span>PHONE</span>

        <h3>
            +91 98765 43210
        </h3>

    </div>

    <div>

        <span>LOCATION</span>

        <h3>
            Jabalpur, India
        </h3>

    </div>

</section>


<!-- SECTION 4 -->

<section class="contact-cta">

    <h2>
        Ready to start?
    </h2>

    <p>
        We usually reply within 24 hours.
    </p>

</section>


<style>

    section {
        padding: 100px 8%;
    }

    .contact-hero {
        min-height: 65vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .contact-hero span,
    .contact-form-section span,
    .contact-info span {
        color: #8b5cf6;
        letter-spacing: 2px;
        font-size: 13px;
    }

    .contact-hero h1 {
        max-width: 1000px;
        font-size: clamp(55px, 8vw, 100px);
        line-height: .9;
        margin: 25px 0;
    }

    .contact-hero strong {
        color: #8b5cf6;
    }

    .contact-hero p {
        color: #999;
        font-size: 19px;
    }

    .contact-form-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        background: #111;
    }

    .contact-form-section h2 {
        font-size: 60px;
        line-height: 1;
        margin-top: 20px;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    input,
    textarea {
        width: 100%;

        padding: 18px;

        background: #090909;

        border: 1px solid #292929;

        border-radius: 10px;

        color: #fff;

        font-size: 16px;

        outline: none;
    }

    textarea {
        min-height: 160px;
        resize: vertical;
    }

    input:focus,
    textarea:focus {
        border-color: #8b5cf6;
    }

    button {
        border: none;

        padding: 17px;

        background: #8b5cf6;

        color: #fff;

        border-radius: 30px;

        font-size: 16px;

        font-weight: bold;

        cursor: pointer;
    }

    .contact-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .contact-info div {
        padding: 30px;
        border: 1px solid #292929;
        border-radius: 18px;
    }

    .contact-info h3 {
        margin-top: 20px;
        font-size: 20px;
    }

    .contact-cta {
        text-align: center;
        background: #171022;
    }

    .contact-cta h2 {
        font-size: 80px;
        margin-bottom: 20px;
    }

    .contact-cta p {
        color: #888;
    }

    @media(max-width: 700px) {

        .contact-form-section,
        .contact-info {
            grid-template-columns: 1fr;
        }

        .contact-cta h2 {
            font-size: 55px;
        }

    }

</style>

<%- include("partials/footer") %>