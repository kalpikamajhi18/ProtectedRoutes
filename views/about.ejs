<%- include("partials/header", { title: "About" }) %>

<%- include("partials/navbar") %>


<!-- SECTION 1 -->

<section class="about-hero">

    <div>

        <span>ABOUT NOVA</span>

        <h1>
            We turn ideas into
            <strong>digital experiences.</strong>
        </h1>

        <p>
            We are a creative digital agency helping
            ambitious businesses build meaningful
            digital products.
        </p>

    </div>

</section>


<!-- SECTION 2 -->

<section class="story">

    <div class="section-left">

        <span>OUR STORY</span>

        <h2>
            Built for modern businesses.
        </h2>

    </div>

    <div class="section-right">

        <p>
            NOVA started with one simple idea:
            businesses deserve better digital experiences.
        </p>

        <p>
            Today we combine design, technology and
            strategy to create websites and digital
            products that deliver real value.
        </p>

    </div>

</section>


<!-- SECTION 3 -->

<section class="values">

    <span>OUR VALUES</span>

    <h2>
        What drives us.
    </h2>

    <div class="value-grid">

        <div>
            <b>01</b>
            <h3>Creativity</h3>
            <p>
                We think differently and challenge
                ordinary solutions.
            </p>
        </div>

        <div>
            <b>02</b>
            <h3>Quality</h3>
            <p>
                Every detail matters in everything
                we build.
            </p>
        </div>

        <div>
            <b>03</b>
            <h3>Impact</h3>
            <p>
                Our work should create measurable
                business value.
            </p>
        </div>

    </div>

</section>


<!-- SECTION 4 -->

<section class="about-cta">

    <h2>
        Let's create something
        meaningful together.
    </h2>

    <a href="/contact">
        Start a Project →
    </a>

</section>


<style>

    section {
        padding: 100px 8%;
    }

    .about-hero {
        min-height: 70vh;

        display: flex;
        align-items: center;

        background:
        radial-gradient(
            circle at 80% 40%,
            #271450,
            #090909 40%
        );
    }

    .about-hero > div {
        max-width: 850px;
    }

    .about-hero span,
    .story span,
    .values > span {
        color: #8b5cf6;
        letter-spacing: 2px;
        font-size: 13px;
        font-weight: bold;
    }

    .about-hero h1 {
        font-size: clamp(50px, 7vw, 90px);
        line-height: .95;
        margin: 25px 0;
    }

    .about-hero strong {
        color: #8b5cf6;
    }

    .about-hero p {
        max-width: 600px;
        color: #999;
        font-size: 19px;
        line-height: 1.7;
    }

    .story {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        background: #111;
    }

    .story h2,
    .values h2 {
        font-size: 55px;
        margin-top: 20px;
    }

    .section-right p {
        color: #999;
        line-height: 1.8;
        font-size: 18px;
        margin-bottom: 25px;
    }

    .value-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 50px;
    }

    .value-grid div {
        padding: 35px;
        background: #111;
        border: 1px solid #292929;
        border-radius: 20px;
    }

    .value-grid b {
        color: #8b5cf6;
    }

    .value-grid h3 {
        margin: 70px 0 15px;
        font-size: 28px;
    }

    .value-grid p {
        color: #888;
        line-height: 1.6;
    }

    .about-cta {
        text-align: center;
        background: #171022;
    }

    .about-cta h2 {
        font-size: clamp(45px, 6vw, 80px);
        margin-bottom: 35px;
    }

    .about-cta a {
        display: inline-block;
        padding: 15px 25px;
        background: #8b5cf6;
        border-radius: 30px;
    }

    @media(max-width: 700px) {

        .story,
        .value-grid {
            grid-template-columns: 1fr;
        }

    }

</style>

<%- include("partials/footer") %>